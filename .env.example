# ---------- app ----------
APP_NAME="Lens API"
ENVIRONMENT=development           # development | production
DEBUG=true

# Comma-separated. In production set your real origins.
CORS_ORIGINS=https://farhat.one,https://www.farhat.one

# ---------- storage ----------
DATA_DIR=./data
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ---------- rate limiting ----------
RATE_LIMIT_MAX_REQUESTS=5         # requests per window, per IP
RATE_LIMIT_WINDOW_SECONDS=3600

# ---------- AI ----------
# Order matters: first provider is primary, rest are fallbacks.
AI_PROVIDER_CHAIN=gemini,openai
AI_TIMEOUT_SECONDS=8

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------- mail ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=
MAIL_FROM_NAME="Farhat Baymuradov"
OWNER_EMAIL=
