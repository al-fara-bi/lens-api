# ---------- app ----------
APP_NAME="Lens API"
ENVIRONMENT=development           # development | production
DEBUG=true

# Comma-separated. In production set your real origins.
CORS_ORIGINS=https://farhat.one,https://www.farhat.one

# ---------- storage ----------
DATA_DIR=./data
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ---------- rate limiting ----------
RATE_LIMIT_MAX_REQUESTS=5         # requests per window, per IP
RATE_LIMIT_WINDOW_SECONDS=3600

# ---------- AI ----------
# Order matters: first provider is primary, the rest are fallbacks in order.
# Unconfigured providers are skipped, so listing all three is safe.
# Put a provider you know is unavailable last — placed first it costs a timeout
# on every single request before the chain falls through.
AI_PROVIDER_CHAIN=groq,openai,anthropic,gemini
AI_TIMEOUT_SECONDS=8

# console.groq.com -> API Keys. Issued without a payment method and with no
# regional restriction on the free tier, which is why it leads the chain.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# console.anthropic.com -> API keys.
# Note: a Claude Pro/Max subscription does NOT include API access — API credits
# are billed separately.
ANTHROPIC_API_KEY=
# Lightest and cheapest model ($1/$5 per MTok); enough for a short
# classification. Heavier options: claude-sonnet-5, claude-opus-4-8.
ANTHROPIC_MODEL=claude-haiku-4-5

# ---------- mail ----------
# Plain SMTP, so any provider works — switching is a config change, not a code
# change. Values below are Resend's; for Gmail use smtp.gmail.com with an app
# password (a regular account password will not authenticate).
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
# Resend -> API Keys -> Create API Key, permission "Sending access". Format: re_...
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Must sit on a domain verified with the provider (SPF + DKIM published in DNS).
# Sending from an unverified domain gets the mail spam-foldered or rejected.
MAIL_FROM=noreply@farhat.one
MAIL_FROM_NAME="Farhat Baymuradov"

# Where new-submission notifications are delivered. The visitor's address is set
# as Reply-To on that mail, so replying goes straight to them.
OWNER_EMAIL=
